{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZYK-Labs/ai-beacon/research/rfc005/re-evidence-result.schema.json",
  "title": "AI-BEACON REEvidenceResult v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact",
    "finding",
    "evidence_refs",
    "tool",
    "commands_or_logs",
    "uncertainty",
    "limitations",
    "authorization",
    "data_flow"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact": {
      "type": "object",
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "finding": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tool": {
      "type": "object",
      "required": ["name", "revision", "runtime"],
      "properties": {
        "name": {"type": "string"},
        "revision": {"type": "string"},
        "runtime": {"type": "string"}
      },
      "additionalProperties": false
    },
    "commands_or_logs": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"enum": ["low", "medium", "high", "unknown"]},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "authorization": {"enum": ["owned", "authorized", "synthetic", "ctf", "intentionally_vulnerable"]},
    "data_flow": {"enum": ["local_only", "synthetic_only"]}
  }
}
